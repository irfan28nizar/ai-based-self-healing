        "label": "Service",
        "name": "service",
        "options": [],
        "query": { "query": "label_values(up, job)", "refId": "Prometheus-service-Variable-Query" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
